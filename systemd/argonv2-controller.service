# Template rendered by scripts/install.sh for this checkout.
[Unit]
Description=Argon ONE V2 fan and power-button controller
After=local-fs.target
RequiresMountsFor="@PROJECT_DIR@"
ConditionPathExists=/dev/i2c-1
ConditionPathExists=/dev/gpiochip0

[Service]
Type=simple
WorkingDirectory="@PROJECT_DIR@"
Environment="HOME=@PROJECT_DIR@"
ExecStart="@PROJECT_DIR@/.argonv2_controller/bin/python" -m argonv2_controller.cli --config "@PROJECT_DIR@/config.toml" run
Restart=on-failure
RestartSec=3
TimeoutStopSec=5

# Hardware access + reboot/poweroff require root for this deliberately simple
# local appliance service.
User=root
Group=root

# Basic hardening that still allows /dev access and systemctl actions.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
